{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "RAWCHUNKS",
  "colors": {
    "primary": "#00ff41",
    "light": "#00ff41",
    "dark": "#00ccff"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#000000",
      "dark": "#000000"
    }
  },
  "fonts": {
    "family": "Courier New",
    "heading": {
      "family": "Courier New",
      "weight": 900
    },
    "body": {
      "family": "Courier New",
      "weight": 400
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "github-dark",
        "dark": "github-dark"
      }
    }
  },
  "favicon": "/favicon.ico",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://rawchunks.space"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://rawchunks.space"
      },
      {
        "type": "github",
        "href": "https://github.com/rawchunks"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Launch App",
      "href": "https://app.rawchunks.space"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "App",
        "groups": [
          {
            "group": "Start",
            "pages": [
              "app/overview",
              "app/account",
              "app/payments",
              "app/generate"
