    "global": {
      "anchors": [
        {
          "anchor": "App",
          "href": "https://app.rawchunks.space",
          "icon": "wave-pulse"
        },
        {
          "anchor": "Website",
          "href": "https://rawchunks.space",
          "icon": "globe"
        }
      ]
    }
  },
  "search": {
    "prompt": "Search Rawchunks\u2026"
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ],
    "display": "header"
  },
  "footer": {
    "socials": {
      "website": "https://rawchunks.space",
      "x": "https://x.com/rawchunks",
      "github": "https://github.com/rawchunks"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/app/overview"
    },
    {
      "source": "/index",
      "destination": "/app/overview"
    },
    {
      "source": "/quickstart",
      "destination": "/app/generate"
    },
    {
      "source": "/dev/endpoints/editing/separate",
      "destination": "/dev/endpoints/editing/isolate"
    }
  ],
  "api": {
    "playground": {
      "display": "simple"
    },
    "examples": {
      "autogenerate": false
    }
  }
